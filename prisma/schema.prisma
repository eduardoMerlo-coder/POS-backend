generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  ENTRY
  SALE
  ADJUSTMENT
  RETURN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             Int    @id @default(autoincrement())
  name           String @db.VarChar(50)
  password       String @db.VarChar(200)
  businessTypeId Int?
  roleId         Int

  businessType BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens      RefreshToken[]
  userVariants       UserProductVariant[]
  inventoryMovements InventoryMovement[]
  inventoryBatches   InventoryBatch[]
}

model BusinessType {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  users        User[]
  productLinks ProductBusinessType[]
}

model Role {
  id    Int    @id @default(autoincrement())
  type  String @unique
  users User[]
}

model UserProductVariant {
  id            Int     @id @default(autoincrement())
  userId        Int
  variantId     Int
  price         Decimal @db.Decimal(10, 2)
  stockQuantity Int     @default(0)
  minStock      Int     @default(0)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  productCategories ProductCategory[]
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductVariant {
  id                 Int                  @id @default(autoincrement())
  productId          Int                  @map("product_id")
  quantityPerPackage Int                  @map("quantity_per_package")
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status             ProductStatus        @default(ACTIVE)
  userVariants       UserProductVariant[]
  inventoryMovements InventoryMovement[]
  images             ProductImage[]

  @@index([productId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  variantId Int
  url       String   @db.VarChar(500)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model Product {
  id                Int                   @id @default(autoincrement())
  barcode           String?               @db.VarChar(20)
  internalCode      String?               @db.VarChar(20)
  name              String                @db.VarChar(100)
  brandId           Int?
  packagingTypeId   Int
  capacity          Decimal               @db.Decimal(10, 2)
  unitId            Int                   @map("unit_id")
  unitOfMeasure     UnitOfMeasure         @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brand             Brand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  packagingType     PackagingType         @relation(fields: [packagingTypeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productCategories ProductCategory[]
  productVariants   ProductVariant[]
  businessLinks     ProductBusinessType[]

  @@unique([barcode, internalCode])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(300)
  products Product[]
}

model PackagingType {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(100)
  description String @db.VarChar(100)

  products Product[]
}

model InventoryBatch {
  id        Int                 @id @default(autoincrement())
  userId    Int
  date      DateTime            @default(now())
  supplier  String?
  note      String?
  movements InventoryMovement[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id        Int          @id @default(autoincrement())
  userId    Int
  batchId   Int?
  variantId Int
  type      MovementType
  quantity  Int
  date      DateTime     @default(now())
  note      String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch   InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([variantId])
}

model ProductBusinessType {
  id             Int @id @default(autoincrement())
  productId      Int
  businessTypeId Int

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@unique([productId, businessTypeId])
}

model UnitOfMeasure {
  id          Int       @id @default(autoincrement())
  unit        String    @unique @db.VarChar(20)
  description String?   @db.VarChar(100)
  products    Product[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique @db.VarChar(100)
  tokenHash String    @unique @db.VarChar(200)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
